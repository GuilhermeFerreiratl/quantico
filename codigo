#include <iostream>
#include <string>
#include <ctime>

using namespace std;

// Variáveis globais para controlar o estado da busca
string caracteres = "abcdefghijklmnopqrstuvwxyz0123456789";
long long tentativas = 0;
bool encontrada = false;

// Função recursiva que monta e testa todas as combinações
void forcaBruta(string atual, int tamanhoMax, const string& alvo) {
    // Se já achou a senha em outro ramo da busca, para imediatamente
    if (encontrada) return; 
    
    // Quando a palavra montada atinge o tamanho desejado, testa se é a senha
    if (atual.length() == tamanhoMax) {
        tentativas++;
        if (atual == alvo) {
            encontrada = true;
            cout << "Sucesso! Senha '" << atual << "' encontrada." << endl;
        }
        return;
    }
    
    // Adiciona um caractere por vez e chama a função novamente
    for (size_t i = 0; i < caracteres.length(); i++) {
        forcaBruta(atual + caracteres[i], tamanhoMax, alvo);
        if (encontrada) return;
    }
}

int main() {
    // Use uma senha curta (4 ou 5 caracteres) para o teste ser rápido
    string senhaSecreta = "059b2"; 
    
    cout << "Tentando adivinhar a senha: '" << senhaSecreta << "'..." << endl;
    
    clock_t inicio = clock(); // Inicia o cronômetro
    
    // Testa combinações de tamanho 1 até o tamanho da senha secreta
    for (size_t tamanho = 1; tamanho <= senhaSecreta.length(); tamanho++) {
        forcaBruta("", tamanho, senhaSecreta);
        if (encontrada) break;
    }
    
    clock_t fim = clock(); // Para o cronômetro
    double tempoGasto = double(fim - inicio) / CLOCKS_PER_SEC;
    
    if (encontrada) {
        cout << "Tentativas: " << tentativas << endl;
        cout << "Tempo gasto: " << tempoGasto << " segundos" << endl;
    } else {
        cout << "Senha nao encontrada." << endl;
    }
    
    return 0;
}
